# Normalise line endings - the repo is developed on Windows, run on Ubuntu.
* text=auto eol=lf
*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
*.urdf text eol=lf
*.xacro text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# ---------------------------------------------------------------------------
# Git LFS. Enable BEFORE the first large commit (`git lfs install`), otherwise
# the blobs stay in history forever and the thesis repo becomes unclonable.
# ---------------------------------------------------------------------------
*.pth   filter=lfs diff=lfs merge=lfs -text
*.pt    filter=lfs diff=lfs merge=lfs -text
*.onnx  filter=lfs diff=lfs merge=lfs -text
*.pcd   filter=lfs diff=lfs merge=lfs -text
*.ply   filter=lfs diff=lfs merge=lfs -text
*.pgm   filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text
*.stl   filter=lfs diff=lfs merge=lfs -text
*.STL   filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text

# Notebooks: diff as text, they are reviewed in PRs.
*.ipynb text
